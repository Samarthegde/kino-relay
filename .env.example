# Copy to .env. Everything here is optional — the defaults are fine.

# Interface to publish the relay on. TLS is terminated upstream by nginx, so the
# relay itself speaks plain HTTP and should NOT be exposed to the internet.
# Lock it to the LAN address nginx proxies to, e.g. LISTEN_ADDR=10.1.10.96
LISTEN_ADDR=0.0.0.0

# trace | debug | info | warn | error
RUST_LOG=info
