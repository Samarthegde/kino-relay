# Copy to .env before `docker compose up -d`.

# ── Kino Cloud enrollment ─────────────────────────────────────────────────────
# Fill these in for the FIRST start; the relay registers itself with
# kino-control, receives its public key, and starts enforcing token auth.
# The code is one-time - get one from the Relays page of your kino-control.
KINO_CONTROL_URL=https://kino.samarthkombemane.com
KINO_ENROLL_CODE=
# The address clients dial. Must already resolve and serve /healthz over TLS
# before you start the relay - kino-control probes it before accepting.
RELAY_PUBLIC_URL=wss://relay.example.com
# Optional label shown in the kino-control dashboard.
RELAY_NAME=

# Optional static shared secret, usable instead of / alongside kino-control
# tokens. Recommended as a safety net: if enrollment fails and this is unset,
# the relay keeps running with NO authentication.
# Generate one: openssl rand -hex 32
RELAY_TOKEN=

# ── Networking ────────────────────────────────────────────────────────────────
# Interface to publish the relay on. TLS is terminated upstream by nginx, so the
# relay speaks plain HTTP and should NOT be exposed to the internet directly.
# The default binds to localhost only; use the LAN address nginx proxies to if
# the proxy runs on another host, e.g. LISTEN_ADDR=10.1.10.96
LISTEN_ADDR=127.0.0.1

# trace | debug | info | warn | error
RUST_LOG=info

# ── Direct TLS (only if you are NOT using a reverse proxy) ────────────────────
#TLS_CERT=/etc/kino-relay/tls/fullchain.pem
#TLS_KEY=/etc/kino-relay/tls/privkey.pem
